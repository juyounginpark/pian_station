  typingSpeed: 0.03
  autoAdvanceTime: 1
  dialogueMappings:
  - objectName: bench_1
    dialogue:
      npcName: "\uBCA4\uCE58 1"
      sentences:
      - "\uC218\uC0C1\uD55C \uBCA4\uCE58\uB2E4."
      - "\uBC11\uC5D0 \uBC18\uC9DD\uC774\uB294 \uBB34\uC5B8\uAC00\uAC00 \uBCF4\uC778\uB2E4."
  - objectName: normal_vending_0
    dialogue:
      npcName: "\uC790\uD310\uAE30"
      sentences:
      - "\uC720\uD589\uC774 \uC9C0\uB09C \uD0C4\uC0B0\uC74C\uB8CC\uB4E4\uB85C \uAD6C\uC131\uB418\uC5B4\uC788\uB2E4."
      - "\uAD00\uC2EC\uC774 \uC0DD\uAE30\uC9C4 \uC54A\uB294\uB2E4."
  - objectName: strange_vending_0
    dialogue:
      npcName: "\uAE30\uC774\uD55C \uC790\uD310\uAE30"
      sentences:
      - ??!
      - "\uC790\uD310\uAE30\uC5D0 \uC774\uC0C1\uD55C \uBB3C\uCCB4\uB4E4\uB85C \uAC00\uB4DD
        \uCC28 \uC788\uB2E4."
      - "... \uB054\uCC0D\uD574"
  - objectName: memo
    dialogue:
      npcName: "\uC218\uC0C1\uD55C \uBA54\uBAA8"
      sentences:
      - "\uC774 \uAE00\uC744 \uBCF4\uC2E0\uB2E4\uBA74"
      - "\uB2F9\uC7A5 \uC124\uBE59\uC5D0 \uAC00\uC11C"
      - "\uB3FC\uC9C0\uBC14 \uBE59\uC218\uB97C \uBA39\uC73C\uC138\uC694."
      - "\uADF8\uAC70 \uB9DB\uC788\uC74C \u3147\u3148?\u314B\u314B"
  - objectName: train_0
    dialogue:
      npcName: main
      sentences:
      - "\uAE30\uCC28..?"
      - "\uC774\uC0C1\uD55C \uD615\uCCB4\uB4E4\uC774 \uD0C0\uACE0 \uC788\uB2E4."
      - ".. \uC120\uB85C\uB85C \uAC00\uB294\uAC74 \uC704\uD5D8\uD558\uACA0\uC5B4"
  - objectName: poster
    dialogue:
      npcName: "\uD6FC\uC190\uB41C \uBCBD\uBCF4"
      sentences:
      - "\uD3EC\uC2A4\uD130\uB4E4\uC774\uB2E4."
      - "\uC5B4\uB9BC\uC7A1\uC544 10\uB144\uC740 \uD6E8 \uC9C0\uB09C \uAC70 \uAC19\uC544."
      - "\uD3EC\uC2A4\uD130 \uC18D \uAE00\uC790\uB4E4\uC5D0 \uB2E8\uC11C\uAC00 \uC788\uC744\uC9C0\uB3C4
        \uBAA8\uB974\uACA0\uC5B4."
